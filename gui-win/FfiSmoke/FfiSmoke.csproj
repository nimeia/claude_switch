<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClaudeSwitch.Core\ClaudeSwitch.Core.csproj" />
  </ItemGroup>
  <!-- Load path for DllImport("claude_switch") is the app directory. The DLL
       comes from wherever Cargo put it (see ClaudeSwitch.Native.targets). -->
  <Import Project="..\ClaudeSwitch.Native.targets" />
  <Target Name="CopyNativeDll" AfterTargets="Build" DependsOnTargets="ResolveClaudeSwitchNative">
    <Copy SourceFiles="$(ClaudeSwitchNativeDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(ClaudeSwitchNativeDll)')" />
    <Warning Text="claude_switch.dll missing at $(ClaudeSwitchNativeDll) — run: cargo build -p claude-switch-ffi --release"
             Condition="!Exists('$(ClaudeSwitchNativeDll)')" />
  </Target>
</Project>

