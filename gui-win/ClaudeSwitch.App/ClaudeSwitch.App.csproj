<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <StartupObject>ClaudeSwitch.App.Program</StartupObject>
    <RootNamespace>ClaudeSwitch.App</RootNamespace>
    <AssemblyName>ClaudeSwitch</AssemblyName>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</Version>

    <!-- Shown in Explorer's Properties and in the SmartScreen prompt. Blank
         fields there are one of the things that make an unsigned download look
         untrustworthy, so they are filled deliberately. -->
    <Product>Claude Switch</Product>
    <AssemblyTitle>Claude Switch</AssemblyTitle>
    <Description>Switch between Claude Code accounts; auto-switch when a rate limit is reached.</Description>
    <Company>claude-switch contributors</Company>
    <Copyright>Copyright (c) 2026 claude-switch contributors — MIT</Copyright>
    <!-- Explorer shows InformationalVersion; the default appends the commit hash,
         which turns "0.1.0" into "0.1.0+10f5fcc…" in the Properties dialog. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- One downloadable file: no .NET install, no loose DLLs to lose. The native
       engine is bundled too and self-extracts on first run. -->
  <PropertyGroup Condition="'$(PublishSingleFileBundle)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming is off: the app reaches WinForms types through reflection, and a
         trimmed build fails at runtime rather than at build time. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <!-- One file means one file: don't drag referenced projects' pdbs along. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeSwitch.Core\ClaudeSwitch.Core.csproj" />
  </ItemGroup>

  <!-- Language catalogues, embedded so the single-file build needs no satellite
       assemblies. Adding a language is dropping one file in here. -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" />
  </ItemGroup>

  <!-- The supervised-run transcript is a local web page (xterm.js draws command
       output). Embedded like the catalogues and served to WebView2 from memory:
       nothing is unpacked to disk, and nothing is fetched. -->
  <ItemGroup>
    <EmbeddedResource Include="AgentView\**\*" LogicalName="AgentView/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- The package references its WPF control in every .NET 5+ project. This app
       is WinForms: the WPF assembly only drags a WindowsBase version conflict
       into every build and an unused DLL into the single-file bundle. -->
  <Target Name="DropWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

  <!-- The Rust engine, built by: cargo build -p claude-switch-ffi (release).
       Found where Cargo put it, not at a fixed target\release path; see
       ClaudeSwitch.Native.targets for why. -->
  <Import Project="..\ClaudeSwitch.Native.targets" />

  <!-- Added in a target rather than as a static item because the path is only
       known once Cargo has been asked. Before AssignTargetPaths, so both the
       copy to bin and the publish (single-file bundle included) pick it up. -->
  <Target Name="IncludeClaudeSwitchNative"
          DependsOnTargets="ResolveClaudeSwitchNative"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup Condition="Exists('$(ClaudeSwitchNativeDll)')">
      <None Include="$(ClaudeSwitchNativeDll)"
            Link="claude_switch.dll"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- The status line renderer, built by: cargo build -p claude-switch-statusline
       (release). Claude Code runs it once per repaint, so it ships as its own
       small binary rather than as a second launch of this app. It travels inside
       the single file and is written out to <backup root>\bin only when the user
       turns the status line on (see crates/core/src/statusline.rs). -->
  <Target Name="IncludeClaudeSwitchStatusline"
          DependsOnTargets="ResolveClaudeSwitchNative"
          BeforeTargets="AssignTargetPaths">
    <ItemGroup Condition="Exists('$(ClaudeSwitchStatuslineExe)')">
      <None Include="$(ClaudeSwitchStatuslineExe)"
            Link="cs-statusline.exe"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="WarnIfNativeMissing" DependsOnTargets="ResolveClaudeSwitchNative" BeforeTargets="Build">
    <Warning
      Condition="!Exists('$(ClaudeSwitchNativeDll)')"
      Text="claude_switch.dll not found at $(ClaudeSwitchNativeDll) — run: cargo build -p claude-switch-ffi --release" />
    <Warning
      Condition="!Exists('$(ClaudeSwitchStatuslineExe)')"
      Text="cs-statusline.exe not found at $(ClaudeSwitchStatuslineExe) — run: cargo build -p claude-switch-statusline --release" />
  </Target>

  <!-- Missing engine is only a warning while developing: the IDE still builds and
       the tests that don't touch the engine still run. Publishing without it is
       different — it produces an exe that dies the moment it launches, and that
       must not be shippable by accident. -->
  <Target Name="RequireNativeForPublish" DependsOnTargets="ResolveClaudeSwitchNative" BeforeTargets="PrepareForPublish">
    <Error
      Condition="'$(PublishSingleFileBundle)' == 'true' And !Exists('$(ClaudeSwitchNativeDll)')"
      Text="Refusing to publish without the native engine ($(ClaudeSwitchNativeDll)). Run first: cargo build -p claude-switch-ffi --release" />
    <!-- A bundle without it still runs, but the status line can never be turned
         on: the app would have nothing to write into <backup root>\bin. That is
         a feature missing from a release, so it fails the publish, not the build. -->
    <Error
      Condition="'$(PublishSingleFileBundle)' == 'true' And !Exists('$(ClaudeSwitchStatuslineExe)')"
      Text="Refusing to publish without the status line renderer ($(ClaudeSwitchStatuslineExe)). Run first: cargo build -p claude-switch-statusline --release" />
  </Target>
  <ItemGroup>
    <!-- Card/drawer controls stay internal; the test project reads their
         pure formatting helpers (e.g. AccountCard.BuildSubLine). -->
    <InternalsVisibleTo Include="ClaudeSwitch.App.Tests" />
  </ItemGroup>
</Project>
